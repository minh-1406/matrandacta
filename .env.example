# GEMINI_API_KEY: Server-side API key for Google Gemini models (Gemini 3.8 Flash, Gemini Live, etc.)
# Used exclusively by the Node.js server proxy (/api/gemini/*). Never exposed to the browser.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
APP_URL="YOUR_APP_URL_HERE"
